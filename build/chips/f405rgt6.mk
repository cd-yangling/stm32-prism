# f405rgt6 —— F405 LQFP64 1M/128K+64K CCM

CHIP_SERIES = f4
CHIP_DEFS = -DSTM32F405xx
FLASH_SIZE = 0x100000
SRAM_SIZE  = 0x20000
SLOT_SIZE  = 0x80000
OCD_TARGET = target/stm32f4x.cfg

# PINS 掩码(LQFP64: D 仅 PD2, H=PH0/PH1)
CHIP_DEFS += -DGPIOA_PINS=0xFFFF -DGPIOB_PINS=0xFFFF -DGPIOC_PINS=0xFFFF \
             -DGPIOD_PINS=0x0004 -DGPIOH_PINS=0x0003
