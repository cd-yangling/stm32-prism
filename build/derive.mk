ifneq ($(filter -DCONFIG_USART%_IRQ -DCONFIG_UART%_IRQ,$(BOARD_DEFS) $(PROJ_DEFS)),)
PROJ_DEFS += -DCONFIG_UART_IRQ
endif
ifneq ($(filter -DCONFIG_USART%_DMA -DCONFIG_USART%_DMA_RX -DCONFIG_USART%_DMA_TX -DCONFIG_UART%_DMA -DCONFIG_UART%_DMA_RX -DCONFIG_UART%_DMA_TX,$(BOARD_DEFS) $(PROJ_DEFS)),)
PROJ_DEFS += -DCONFIG_UART_DMA
endif
